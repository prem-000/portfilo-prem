# Environment Variables (Optional)
# Copy this file to .env.local for local overrides

NEXT_PUBLIC_SITE_URL=https://prem-000.github.io
# NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# Optional: GitHub Personal Access Token (classic with 'read:user' scope or fine-grained public-read)
# Used server-side for GitHub GraphQL contributions API; falls back to public scraper if unset
GITHUB_TOKEN=your_github_personal_access_token_here
